# Acting — Caddy site blocks. Append these to the END of
# /root/fleetsathi/Caddyfile on the server (mounted into fms-caddy at
# /etc/caddy/Caddyfile). Do not remove or reorder the existing fleetsathi
# blocks. Both hostnames resolve to 94.136.189.234 via DNS.
#
# Container hostnames resolve via Docker's embedded DNS because acting-landing
# and acting-admin share the "acting-shared" network with fms-caddy.
# Ports are the CONTAINERS' internal ports, not host ports.

# Public marketing website
acting.loankard.com {
    reverse_proxy acting-landing:3200
}

# Staff operations panel
admin.acting.loankard.com {
    reverse_proxy acting-admin:3100
}
