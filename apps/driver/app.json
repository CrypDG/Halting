{
  "expo": {
    "name": "Acting Driver",
    "slug": "actingdriver",
    "version": "0.1.0",
    "scheme": "acting-driver",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "android": {
      "package": "app.acting.driver",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Acting streams your location to customers while you are online or on a trip."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "32e6bb1a-145f-483a-b528-5e41b980012b"
      }
    },
    "owner": "actingdrivers-team"
  }
}
